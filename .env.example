# Supabase Configuration
# Get these values from https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for API routes that bypass RLS)
# Find at: https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (Email notifications)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Cron Secret (optional, for securing cron endpoint)
CRON_SECRET=your-cron-secret-here

# Supabase MCP Server (.mcp.json) — DB 연동을 위한 MCP 서버 설정에서 참조
# Personal Access Token: https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
# 프로젝트 Reference ID (대시보드 Settings → General): https://app.supabase.com/project/_/settings/general
SUPABASE_PROJECT_REF=your-project-ref
